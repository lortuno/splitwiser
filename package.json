{
  "name": "travel-expenses",
  "version": "0.1.0",
  "private": true,
  "main": "packages/app/index.ts",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "web": "expo start --port 8081",
    "api": "cd packages/api && php bin/init-db.php && php -S 0.0.0.0:8080 -t public public/index.php",
    "export:native": "expo export --platform ios --platform android --output-dir dist-native",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.15",
    "expo": "58.0.19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  }
}
